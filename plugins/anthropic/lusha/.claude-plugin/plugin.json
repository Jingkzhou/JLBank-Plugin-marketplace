{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "lusha",
  "version": "0.1.2",
  "description": "使用 Lusha 的 B2B 情报平台（经过验证的电话号码、公司信号和相似定位）来寻找、丰富和构建可通话的潜在客户列表。",
  "author": {
    "name": "Lusha",
    "email": "support@lusha.com",
    "url": "https://www.lusha.com"
  },
  "homepage": "https://www.lusha.com",
  "repository": "https://github.com/lusha-oss/lusha-mcp-plugin",
  "license": "MIT",
  "keywords": [
    "lusha",
    "b2b",
    "sales-intelligence",
    "prospecting",
    "data-enrichment",
    "lead-enrichment",
    "verified-emails",
    "phone-numbers",
    "buying-signals",
    "contacts",
    "companies",
    "revops",
    "mcp"
  ],
  "mcpServers": {
    "lusha": {
      "type": "http",
      "url": "https://mcp.lusha.com/mcp/claude",
      "headers": {
        "X-Lusha-Plugin": "claude",
        "X-Lusha-Plugin-Version": "0.1.2"
      }
    }
  }
}
