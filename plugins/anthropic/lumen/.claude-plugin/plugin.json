{
  "name": "lumen",
  "version": "0.0.42",
  "description": "通过 MCP 进行精确的本地语义代码搜索。使用 Go AST 解析为您的代码库建立索引，嵌入 Ollama 或 LM Studio，并通过 MCP 服务器向 Claude 公开矢量搜索 — 无需云，无需 npm。",
  "author": {
    "name": "Ory Corp",
    "url": "https://github.com/ory"
  },
  "homepage": "https://github.com/ory/lumen",
  "repository": "https://github.com/ory/lumen",
  "license": "Apache-2.0",
  "keywords": [
    "semantic-search",
    "code-index",
    "mcp",
    "embeddings",
    "ollama",
    "rag"
  ],
  "mcpServers": {
    "lumen": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run",
      "args": [
        "stdio"
      ]
    }
  }
}
